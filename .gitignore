# Dependencies
node_modules/
**/node_modules/

# Root lockfile — intentionally NOT committed. It pins native optional
# binaries (e.g. @swc/core-*, @next/swc-*) to whatever platform generated it;
# a Windows-generated lock breaks `npm install` in the Linux deploy container
# (missing @swc/core-linux-x64-gnu etc). Let each environment (local dev,
# Railpack/Docker build) resolve its own. apps/server/package-lock.json is
# unaffected (that workspace has no native optional deps) and stays committed.
/package-lock.json

# Env / secrets
.env
.env.local
**/.env
!**/.env.example
!**/.env.production.example

# Build output
dist/
build/
.next/
**/.next/
**/dist/
**/build/

# Expo / React Native
.expo/
**/.expo/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
**/android/app/build/
**/ios/build/

# Logs & caches
*.log
npm-debug.log*
.turbo/
*.tsbuildinfo

# OS / editor
.DS_Store
Thumbs.db

# Dev screenshots (verification artifacts)
.expo-screenshot.png
**/.expo-screenshot.png

# Temporary test artifacts (screenshots / UI hierarchy dumps)
/tmp/

# one-off dev DB copy helper
apps/server/_copy_db_to_local.mjs
